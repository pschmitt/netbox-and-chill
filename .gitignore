# Gradle files
.gradle/
build/

# Generated by git-hooks.nix (flake.nix) on `nix develop` entry
.pre-commit-config.yaml

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# IntelliJ
*.iml
.idea/*
!.idea/dictionaries/
!.idea/ktfmt.xml
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/README.md

# Locally-generated Play Store screenshots (`just screenshots`) stay untracked by default, but the
# curated images under android/en-US/images/ are exactly what screenshots.yaml's open-pr job
# commits into a review PR, so that subtree (and its parents) must stay un-ignored.
fastlane/metadata/*
!fastlane/metadata/android
fastlane/metadata/android/*
!fastlane/metadata/android/en-US
fastlane/metadata/android/en-US/*
!fastlane/metadata/android/en-US/images

# dist output from justfile fetch recipes
/dist/

# Session-local Claude Code harness state (scheduled/looped task locking), not repo content
/.claude/
